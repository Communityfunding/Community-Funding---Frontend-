# Community Fundings — frontend configuration
# Copy to .env.local and fill in. Never commit .env.local.

# ── Backend API (required) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Clerk (sign-in) ──────────────────────────────────────────────────
# From the Clerk dashboard, for the same instance the backend verifies against.
# Leave both blank in local development and Clerk starts in keyless mode,
# creating a temporary development instance automatically.
# Required for `npm run build`, which fails without a publishable key.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Stripe ───────────────────────────────────────────────────────────
# Publishable key only (pk_test_... in development). Never put a secret key here:
# anything prefixed NEXT_PUBLIC_ is visible in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── AWS ──────────────────────────────────────────────────────────────
# Optional: region used to build campaign media URLs, defaults to us-east-2
NEXT_PUBLIC_AWS_REGION=us-east-2

# ── Development helpers ──────────────────────────────────────────────
# Optional: set to true to show the campaign draft debug panel.
NEXT_PUBLIC_SHOW_DRAFT_DEBUG=false
